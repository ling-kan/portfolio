/* Reveal Preloader Styles */

.reveal-preloader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  background: #fff;
}

.reveal-preloader.dark {
  background: #000;
}

.reveal-preloader__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  width: 100%;
  padding: 1.5rem;
}

.reveal-preloader__spinner {
  position: relative;
  width: 6rem;
  height: 6rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reveal-preloader__glow {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #3b82f6, #a855f7);
  border-radius: 50%;
  filter: blur(20px);
  opacity: 0.75;
}

.reveal-preloader__inner {
  position: relative;
  width: 5rem;
  height: 5rem;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.reveal-preloader.dark .reveal-preloader__inner {
  background: #000;
}

.reveal-preloader__ring {
  width: 4rem;
  height: 4rem;
  border: 4px solid transparent;
  border-top-color: #3b82f6;
  border-right-color: #a855f7;
  border-radius: 50%;
  animation: spinRing 2s linear infinite;
}

@keyframes spinRing {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.reveal-preloader__progress-bar {
  width: 100%;
  max-width: 20rem;
  height: 4px;
  background: #e5e7eb;
  border-radius: 9999px;
  overflow: hidden;
}

.reveal-preloader.dark .reveal-preloader__progress-bar {
  background: #1f2937;
}

.reveal-preloader__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #a855f7);
  border-radius: 9999px;
  transform-origin: left;
}

.reveal-preloader__text {
  font-size: 0.875rem;
  font-weight: 600;
  color: #4b5563;
  letter-spacing: 0.1em;
  animation: pulse 2s ease-in-out infinite;
}

.reveal-preloader.dark .reveal-preloader__text {
  color: #9ca3af;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
  .reveal-preloader {
    background: #000;
  }

  .reveal-preloader__inner {
    background: #000;
  }

  .reveal-preloader__progress-bar {
    background: #1f2937;
  }

  .reveal-preloader__text {
    color: #9ca3af;
  }
}
