{
  "name": "contentful-starter-gatsby-blog",
  "description": "Contentful Gatsby Starter Blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean && rm -rf node_modules package-lock.json",
    "prebuild": "rm -rf .cache/adapters/node_modules/.bin",
    "heroku-postbuild": "gatsby build",
    "postinstall": "node ./bin/hello.js",
    "setup": "node ./bin/setup.js",
    "contentful-removal": "rm -rf .cache public",
    "github:deploy": "gh-pages -d public",
    "// ── NETLIFY ─────────────────────────────────────": "",
    "netlify:login": "netlify login",
    "netlify:deploy": "netlify deploy -d public -p",
    "// ── ALIASES ─────────────────────────────────────": "",
    "alt": "npm run alt:generate",
    "improve": "npm run blog:improve",
    "// ── WORKFLOW A — AI ALT TEXT ────────────────────": "",
    "alt:generate": "node scripts/contentful-alt-generator/generate-alt-text.js",
    "alt:generate:dry": "DRY_RUN=1 node scripts/contentful-alt-generator/generate-alt-text.js",
    "alt:force": "FORCE_REGENERATE=1 node scripts/contentful-alt-generator/generate-alt-text.js",
    "// ── WORKFLOW B — BLOG POST IMPROVER ─────────────": "",
    "improve-blogposts": "node scripts/2-improve-blogposts.js",
    "blog:improve": "node scripts/2-improve-blogposts.js",
    "blog:improve:dry": "DRY_RUN=1 node scripts/2-improve-blogposts.js",
    "blog:improve:force": "FORCE_REGENERATE=1 node scripts/2-improve-blogposts.js",
    "// ── WORKFLOW C — JSON PIPELINE ──────────────────": "",
    "pull": "node scripts/1-pull-from-contentful.js",
    "apply": "node scripts/3-apply-improvements.js contentful-export.json improvements.json updated.json",
    "push": "node scripts/5-push-to-contentful.js",
    "push:test": "CONTENTFUL_ENVIRONMENT_ID=test node scripts/5-push-to-contentful.js",
    "push:prod": "CONTENTFUL_ENVIRONMENT_ID=master node scripts/5-push-to-contentful.js",
    "// ── WORKFLOW D — ENVIRONMENT PROMOTION ──────────": "",
    "deploy:prod": "bash scripts/5-deploy-to-production.sh",
    "// ── COMPOSITE PIPELINES ─────────────────────────": "",
    "pipeline:pull-apply": "npm run pull && npm run apply",
    "pipeline:full-local": "npm run pull && npm run apply && npm run push:test",
    "pipeline:promote": "npm run push:test && npm run deploy:prod",
    "// ── HOUSEKEEPING (pipeline only, does not touch Gatsby cache)": "",
    "clean:dry": "echo \"Will delete: contentful-export.json updated.json improvements.json changeset.json migration.js\"",
    "clean:pipeline": "rm -f contentful-export.json updated.json improvements.json changeset.json migration.js",
    "clean:log": "rm -rf logs/*.log",
    "doctor": "node -e \"require('dotenv').config(); ['GATSBY_CONTENTFUL_SPACE_ID','CONTENTFUL_MANAGEMENT_TOKEN','GATSBY_CONTENTFUL_DELIVERY_TOKEN'].forEach(k => console.log(k + ':', process.env[k] ? '✅ set' : '❌ missing'));\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tippyjs/react": "^4.2.6",
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "babel-plugin-styled-components": "^2.1.4",
    "contentful-management": "^12.19.1",
    "detect-libc": "2.1.1",
    "fs-extra": "10.1.0",
    "gatsby": "5.14.6",
    "gatsby-plugin-image": "^3.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-nprogress": "^5.14.0",
    "gatsby-plugin-react-helmet-async": "^1.2.3",
    "gatsby-plugin-react-svg": "^3.3.0",
    "gatsby-plugin-sass": "^6.14.0",
    "gatsby-plugin-sharp": "^5.14.0",
    "gatsby-plugin-sitemap": "^6.14.0",
    "gatsby-plugin-styled-components": "^6.14.0",
    "gatsby-source-contentful": "^8.15.0",
    "gatsby-transformer-remark": "^6.14.0",
    "gatsby-transformer-sharp": "^5.14.0",
    "lottie-react": "^2.4.1",
    "motion": "^12.23.12",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^1.3.0",
    "react-lottie": "^1.2.10",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@netlify/plugin-gatsby": "3.8.4",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.21",
    "gatsby-plugin-postcss": "^6.14.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "sass": "^1.90.0",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "es5-ext": "0.10.49"
  },
  "engines": {
    "node": "20.18.0",
    "npm": ">=9.0.0"
  }
}
